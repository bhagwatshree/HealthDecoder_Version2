// Copy this file to Secrets.xcconfig (gitignored, per-machine — same role as Android's
// local.properties) and fill in real values. Secrets.xcconfig is referenced by project.yml
// as the Debug/Release base config, so these become Info.plist entries read at runtime by
// BuildKeys.swift.
//
// GEMINI_API_KEY is required for the scan/OCR pipeline to work at all — get one free at
// https://aistudio.google.com/apikey
//
// SARVAM_API_KEY is optional; Sarvam-specific features (Indic OCR routing, TTS) degrade
// gracefully without it, same as Android.
//
// GOOGLE_WEB_CLIENT_ID is not used yet (Google Sign-In lands in a later phase) — leave blank.

GEMINI_API_KEY =
SARVAM_API_KEY =
GOOGLE_WEB_CLIENT_ID =
