# --- Secrets ---
backend/.env
.claude/settings.local.json

# --- Backend (Node) ---
backend/node_modules/
backend/uploads/*
!backend/uploads/.gitkeep
npm-debug.log*

# --- Android / Gradle ---
android-app/.gradle/
android-app/.kotlin/
android-app/build/
android-app/local.properties
android-app/app/google-services.json
android-app/keystore/
*.jks
*.keystore
android-app/app/build/
*.iml
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# --- Build artifacts ---
*.apk
# Exception: hand-picked APKs deliberately committed for distribution (see releases/README.md)
!releases/*.apk

# --- AWS SAM ---
backend/.aws-sam/
samconfig.toml
backend/github-secrets.txt

# --- Local debug captures ---
scratch_*.txt

# --- iOS / Xcode ---
ios-app/Secrets.xcconfig
ios-app/HealthDecoder/GoogleService-Info.plist
ios-app/*.xcodeproj/
ios-app/*.xcworkspace/
ios-app/build/
ios-app/.build/
ios-app/DerivedData/
ios-app/.swiftpm/
# Info.plist is generated from project.yml by xcodegen, like the .xcodeproj itself.
ios-app/Generated/
xcuserdata/

# Firebase iOS config — pulled from the separate secrets repo, never committed here.
# Without this line a plain `git add -A` stages it the moment it is dropped into ios-app/.
ios-app/GoogleService-Info.plist
android-app/app/google-services.json
